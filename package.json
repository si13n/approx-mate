    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/ui": "2.1.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
